# Sys1 stopping test: rtol is relative to the INITIAL residual, so it cancels any
# gain from a better initial guess.  Adds -sys1warm (atol = sys1_tol*||b|| on the
# unpreconditioned residual + warm start from the previous step) and -sys1tol.
# Opt-in: without -sys1warm nothing changes.
# Apply on branch cardiac-sim-fakegeo:  git apply asm_bug_demo/sys1_stopping_test.patch
# Rationale: asm_bug_demo/REPORT_recycling_math_zh.md §1.3
diff --git a/asm_bug_demo/cardiac/forward_ecg.cpp b/asm_bug_demo/cardiac/forward_ecg.cpp
index 81a933c..4a98b47 100644
--- a/asm_bug_demo/cardiac/forward_ecg.cpp
+++ b/asm_bug_demo/cardiac/forward_ecg.cpp
@@ -429,6 +429,27 @@ int main(int argc, char *argv[])
     bool warmstart = false, no_meanremove = false, do_fischer = false;
     opts.AddOption(&warmstart, "-warmstart", "--warmstart", "-cold", "--cold",
                    "Warm-start Sys2 from the previous time-step u_e (initial guess).");
+    // ---- Sys1 stopping test -------------------------------------------------
+    // PETSc's rtol is measured against the INITIAL residual r0 = b - A x0.  A better
+    // initial guess shrinks r0, and the convergence target shrinks with it, so the
+    // number of digits to gain -- and hence the iteration count -- does not move:
+    // under the default test ANY initial-guess work on Sys1 is invisible.  This
+    // option switches Sys1 to an absolute target on the UNPRECONDITIONED residual,
+    // which is what the Sys2 path already does (:2547), and warm-starts from the
+    // previous step.  Keep sys1_tol at the accuracy rtol=1e-10 delivers from a cold
+    // start, so the change of test is measured on its own, not mixed with a looser
+    // solve.
+    bool   do_sys1warm = false;
+    double sys1_tol    = 1e-10;
+    opts.AddOption(&do_sys1warm, "-sys1warm", "--sys1warm", "-nosys1warm", "--no-sys1warm",
+                   "Sys1: use atol = sys1_tol*||b|| on the unpreconditioned residual "
+                   "instead of rtol (which is relative to the initial residual and "
+                   "therefore cancels any gain from a better guess), and warm-start from "
+                   "the previous step.  The warm start is free: Vm still holds V^n when "
+                   "cg1.Mult is called.");
+    opts.AddOption(&sys1_tol, "-sys1tol", "--sys1tol",
+                   "Sys1 stopping accuracy as a fraction of ||b|| (default 1e-10 = the "
+                   "accuracy the current rtol delivers from a cold start).");
     opts.AddOption(&do_fischer, "-fischer", "--fischer", "-nofischer", "--no-fischer",
                    "Cross-time accel for the Sys2 EP-loop solve: MFEM-CG (||b||-relative "
                    "tol) + Fischer A-orthonormal projection of the previous u_e history "
@@ -686,6 +707,13 @@ int main(int argc, char *argv[])
     HypreToPetscAIJ(*A1h, A1p, "Sys1_A1", rank, 1, true);
         PetscPCGSolver cg1(A1p, "sys1_");
     cg1.SetRelTol(1e-10); cg1.SetMaxIter(500); cg1.iterative_mode = false;
+    // The preconditioned-residual test (PETSc's default) also masks guess quality,
+    // so -sys1warm switches the norm type as well; scoped to the option so the
+    // default path is untouched.
+    if (do_sys1warm){
+        KSPSetNormType((KSP)cg1, KSP_NORM_UNPRECONDITIONED);
+        cg1.iterative_mode = true;      // belt and braces; the KSP flag set per step
+    }                                   // below is what actually carries the guess
     { PC pc; KSPGetPC((KSP)cg1, &pc); PCSetType(pc, PCBJACOBI); }
     // per-DOF TP06 cells (one per LOCAL true dof on the heart)
     const int nloc = fes_h.GetTrueVSize();
@@ -2500,6 +2528,16 @@ int main(int argc, char *argv[])
         Bh->Mult(Vm, rhs);
         M->Mult(react, tmp);
         rhs += tmp;
+        if (do_sys1warm){
+            // Absolute target recomputed each step, and the previous solution as the
+            // initial guess.  Vm still holds V^n here (Bh->Mult(Vm,rhs) above read it),
+            // so the warm start costs no storage and no extra work.  iterative_mode does
+            // not propagate to the KSP after construction, hence the explicit call.
+            const double bn1 = std::sqrt(InnerProduct(MPI_COMM_WORLD, rhs, rhs));
+            cg1.SetRelTol(0.0);
+            cg1.SetAbsTol(std::max(sys1_tol*bn1, 1e-300));
+            KSPSetInitialGuessNonzero((KSP)cg1, PETSC_TRUE);
+        }
         cg1.Mult(rhs, Vm);                            // solve Sys1
 
         // activation detection (V crosses 0 mV)
