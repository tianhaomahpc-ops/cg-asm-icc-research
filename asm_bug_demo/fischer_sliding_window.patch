-    std::vector<Vector> fisch_P, fisch_AP;   // A-orthonormal history + A*history
+    // SLIDING WINDOW over the last FISCH_MAX SOLUTIONS.  Keeping an A-orthonormal
+    // basis and evicting its OLDEST VECTOR is NOT the same thing: every kept
+    // vector was orthogonalised against the evicted one, so erase(begin())
+    // deletes a direction that all the remaining solutions still contain, and
+    // the window stops representing the recent history.  (Measured in
+    // asm_bug_demo/fischer_vm_test.c: with no eviction the two are identical
+    // step for step; once eviction starts, evict-oldest-orthonormal collapses to
+    // about cold while the raw window keeps its full gain.)  So keep the
+    // snapshots RAW and take the A-optimal coefficients from their Gram matrix:
+    // same projection, exact window, and two Allreduces per step instead of four
+    // (no Gram-Schmidt at all, hence no acceptance threshold to tune either).
+    std::vector<Vector> fisch_U, fisch_AU;   // raw mean-zero snapshots + A*them
+    std::vector<double> fisch_G;             // row-major m x m, G_kl=<u^k,A u^l>
     Vector ue_prev(nloc); ue_prev = 0.0;     // previous cold u_e (warm-start seed)
     const int FISCH_MAX = 16;
     long fisch_cold=0, fisch_warm=0, fisch_fis=0, fisch_phys=0;   // cumulative iteration tallies
