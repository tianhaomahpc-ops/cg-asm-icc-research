+    // c = G^+ f : the A-optimal coefficients over span{u^k}.  The snapshot Gram
+    // is numerically singular once consecutive solutions become nearly collinear
+    // (the plateau), so use a truncated symmetric pseudo-inverse.  m <= FISCH_MAX
+    // and G is replicated, so this is a purely local O(m^3) LAPACK call.
+    auto gram_solve = [&](const std::vector<double>&G, const std::vector<double>&f,
+                          std::vector<double>&c){
+        const int m=(int)f.size(); c.assign(m,0.0); if (!m) return;
+        std::vector<double> Q(G), ev(m);
+        char jz='V', up='U'; int NN=m, info=0, lw=-1; double wq=0;
+        dsyev_(&jz,&up,&NN,Q.data(),&NN,ev.data(),&wq,&lw,&info);
+        lw=(int)wq; std::vector<double> work(std::max(1,lw));
+        dsyev_(&jz,&up,&NN,Q.data(),&NN,ev.data(),work.data(),&lw,&info);
+        if (info) return;
+        const double emax = ev[m-1];
+        for (int e=0;e<m;++e){
+            if (ev[e] <= 1e-12*emax || ev[e] <= 0) continue;
+            const double *v = &Q[(size_t)e*m];          // eigenvector e (col-major)
+            double vf=0; for (int i=0;i<m;++i) vf += v[i]*f[i];
+            const double sc = vf/ev[e];
+            for (int i=0;i<m;++i) c[i] += sc*v[i];
+        }
+    };
